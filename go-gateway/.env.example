# 网关认证 token（必填）
# Claude Code 用此 token 调用网关
LITELLM_MASTER_KEY=sk-local-gateway-xxx

# 可选：独立的原生管理端 token；不设置时使用上面的 master key
# ADMIN_TOKEN=sk-local-admin-xxx

# 智谱 BigModel
GLM_API_KEY=

# 阿里 MaaS（qwen3.8-max-preview, ali-opus）
ALI_API_KEY=
# 兼容旧的本地配置名（ALI_API_KEY 优先）
# ALIYUN_MAAS_API_KEY=


# HTTP 代理（访问 ChatGPT Codex API 时可选，国内网络通常需要）
# 不设置时直接连接；设置后优先使用此代理。
# HTTP_PROXY=http://127.0.0.1:7890

# 可选：指定 ChatGPT/Pi OAuth 凭证文件。
# 未设置时依次读取 ~/.codex/auth.json、~/.pi/agent/auth.json。
# CHATGPT_AUTH_FILE=

# GitHub Copilot（短期 token，约 30 分钟有效）
# COPILOT_TOKEN=
# GitHub OAuth token（用于自动刷新 Copilot token）
# COPILOT_GITHUB_TOKEN=

# DeepV Server（EasyCode/DeepVCode 聚合服务，读本地 JWT 登录态，无需 API Key）
# 启用后提供 deepseek-v4-flash 与 deepseek-v4-flash-vision-exp 两个模型。
# 认证 token 自动读取 ~/.easycode-user/jwt-token.json，其次 ~/.deepv/jwt-token.json。
DEEPV_ENABLED=false
# 可选：DeepV 工作目录（用于附加 Git 仓库信息头，默认取网关启动目录）
# DEEPV_WORK_DIR=

# 网关监听端口（默认 4001）
PORT=4001
# 日志级别
LOG_LEVEL=info

# ── 账号渠道（第二类）OAuth 客户端凭据 ─────────────────────────────────────
# 各渠道的账号凭据由管理面板发起登录后自动落到 <LLM_GATEWAY_HOME>/channels/
# （0600 文件），不在这里配置。下面只有 gemini 需要手动提供的「OAuth 客户端
# 凭据」——它是你自己注册 Google OAuth 桌面应用拿到的，不是账号令牌。
# 注册时回调地址填 http://localhost:<端口>/oauth-callback。
# 也可改写成 <LLM_GATEWAY_HOME>/gemini-client.json：{"client_id":"..","client_secret":".."}。
# 未配置时 gemini 登录会直接报错并提示填这里，不影响其他渠道。
# GEMINI_CHANNEL_CLIENT_ID=
# GEMINI_CHANNEL_CLIENT_SECRET=
# 兼容旧的本地配置名（上面的 GEMINI_CHANNEL_* 优先）
# CMDC_PAK_GOOGLE_CLIENT_ID=
# CMDC_PAK_GOOGLE_CLIENT_SECRET=
#
# trae：登录时用 Trae 客户端标识拼授权地址（https://www.trae.cn/authorization?...）。
# 这是第三方客户端的标识，不进公开仓库，需要自行提供其中之一：
#   - TRAE_CHANNEL_CLIENT_ID / TRAE_CHANNEL_APP_ID 环境变量；或
#   - <LLM_GATEWAY_HOME>/trae-client.json：{"client_id":"..","app_id":".."}。
# 二者都未配置时 trae 登录会直接报错并给出指引，不影响其他渠道。
# TRAE_CHANNEL_CLIENT_ID=
# TRAE_CHANNEL_APP_ID=
# macOS 自动读取 /Applications 或 ~/Applications 下 TRAE CN 安装包中的 product.json。
# 非标准安装路径可指定 product.json（只读取客户端配置，不导入客户端账号令牌）：
# TRAE_CHANNEL_CLIENT_PRODUCT=
#
# loomy（讯飞 Loomy 桌面客户端）：登录是「微信扫码 + 回环服务」，扫码走 open.weixin.qq.com，
# 绑定/换码走讯飞账号端，后者要求 HMAC-SHA1 签名，需要讯飞账号侧的应用密钥。
# 这是第三方客户端密钥，不进公开仓库，需要自行提供：
#   - LOOMY_ACCESS_KEY_ID / LOOMY_ACCESS_KEY_SECRET 环境变量；或
#   - <LLM_GATEWAY_HOME>/loomy-client.json：{"access_key_id":"..","access_key_secret":".."}。
# 二者都未配置时 loomy 登录会直接报错并给出指引，不影响其他渠道。
# app_id 与微信 AppID 是公开标识，有内置默认值，需要覆盖时才配：
#   LOOMY_APP_ID（默认 GM3LOOMY）、LOOMY_WECHAT_APP_ID（默认 wx18d60be432287cf8）。
# LOOMY_ACCESS_KEY_ID=
# LOOMY_ACCESS_KEY_SECRET=
# LOOMY_APP_ID=
# LOOMY_WECHAT_APP_ID=
#
# raccoon（商汤 / Senser「小浣熊」桌面客户端）：登录有微信扫码与短信两条路径，都无需
# 第三方应用密钥，开箱可用。短信下发前需要过阿里云滑块验证码，验证码参数由官方前端
# 组件回传；手机号用 AES-128-CFB 加密后提交，密钥是客户端内置常量（默认 senseraccoon2023），
# 仅当服务端换钥时才需覆盖：
# RACCOON_PHONE_CIPHER_SECRET=
#
# opencode（OpenCode Zen）：免费档仅供官方 OpenCode 客户端使用，网关不支持；付费模型用
# 设备码流程登录（网关向 console 申请 device_code，用户在浏览器输入 user_code 完成授权），
# 登录后令牌即 Zen 的 Bearer key。设备码流程的 client_id 是公开标识（opencode-cli），
# 不需要任何第三方应用密钥。唯一可调项是复刻用的 User-Agent 版本号（上游会升级版本，
# 硬编码默认值跟不上时用它覆盖，需形如 opencode/<version>）：
# OPENCODE_USER_AGENT=

# Provider 熔断：连续失败次数、恢复探测间隔、半开成功次数
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_RECOVERY_SECONDS=30
CIRCUIT_SUCCESS_THRESHOLD=1

# ── 对话归档 ──────────────────────────────────────────────────────────────
# 归档默认关闭。启用后会将完整的 request/response 正文（脱敏后）写入
# conversation_archives 表，与 request_logs 物理隔离，可用于知识库增量导出。
# ARCHIVE_ENABLED=false
# 单条 body 的截断阈值（KB），超出部分会被截断并标记 ...[truncated]
# ARCHIVE_MAX_BODY_KB=16384
# 归档保留天数，超期记录由后台清理任务自动删除
# ARCHIVE_RETENTION_DAYS=90

# 硅基流动（免费 bge-m3 嵌入与 TeleSpeech ASR）
# Kilo 免费池无需 Key（allow_no_key），此变量可留空；填写则随请求发送
KILO_API_KEY=
SILICONFLOW_API_KEY=

# ── Agent 长期记忆 ────────────────────────────────────────────────────────
# 记忆层默认关闭。启用后提供 /v1/memory（按作用域检索/起草）与
# /admin/memories（治理：确认/退役/删除）。agent 起草一律进 candidate，
# 需管理员确认后生效；密钥类内容在写入前被拒绝。
# MEMORY_ENABLED=false

# ── 常驻助理（EasyAgent SDK）────────────────────────────────────────────────
# 内嵌 EasyAgent 智能体：LLM 调用回环走网关自身（吃同一套路由/fallback/指标），
# 挂载于 POST /admin/assistant/chat（SSE），可检索记忆、提案候选记忆。
# ASSISTANT_ENABLED=false
# 助理使用的模型 ID（须为 /v1/models 中存在的 ID）
# ASSISTANT_MODEL=glm-5.3-flash
# 助理 LLM 出口（默认 http://127.0.0.1:<PORT>，即网关自身）
# ASSISTANT_BASE_URL=
# 助理 API Key（默认复用 MASTER_KEY）
# ASSISTANT_API_KEY=

# ── 技能面板（custom-skills 技能市场）───────────────────────────────────────
# 指向 custom-skills 仓库根目录（内含 registry/skills.json 与 skills/）。
# 原生管理端的技能页使用此目录：浏览技能目录、维护 skills.enabled.json
# 启用清单，并把启用的技能以符号链接同步到本地技能目录。不设置则面板显示配置提示。
# SKILLS_REPO_PATH=

# ── 技能市场（远端技能商城）─────────────────────────────────────────────────
# 默认启用，浏览/安装/卸载远端商城技能；安装目录默认 ~/.agents/skills，
# 与 EasyAgent 共用，互相识别对方安装的技能。
# SKILLS_MARKET_ENABLED=false
# SKILLS_MARKET_BASE_URL=
# SKILLS_MARKET_SKILLS_DIR=

# ── cc-switch 迁移密钥 ──────────────────────────────────────────────────────
# `llm-gateway migrate cc-switch`（或 POST /admin/ccswitch/import）会把从
# cc-switch 迁移来的 API Key 以 CCS_<名称>_API_KEY 的形式追加到这里，
# 并在 providers.yaml 引用；不需要手工填写。
# CCS_MYGLM_API_KEY=

# 路由等待限制（秒）；有实际输出后只应用 idle 限制，不限制整段流的总时长
ROUTING_FIRST_OUTPUT_SECONDS=15
# 思考档默认须容得下始终思考模型的长思考；预算默认跟着思考档走，
# per-provider 覆盖见 providers.yaml 的 first_output_timeout_seconds
ROUTING_REASONING_FIRST_OUTPUT_SECONDS=120
ROUTING_STREAM_IDLE_SECONDS=30
ROUTING_ATTEMPT_SECONDS=30
ROUTING_FALLBACK_WAIT_SECONDS=180
# 429 缺少有效 Retry-After 时指数冷却，最多 300 秒
RATE_LIMIT_INITIAL_SECONDS=30
RATE_LIMIT_MAX_SECONDS=300
# 模型健康：探测结论有效期；自动 doctor 默认关闭，付费/账号模型不自动发推理请求。
MODEL_HEALTH_TTL_SECONDS=900
MODEL_HEALTH_INTERVAL_SECONDS=0
MODEL_HEALTH_PROBE_ANONYMOUS=false
