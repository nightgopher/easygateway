[Unit]
Description=EasyGateway - personal AI infrastructure gateway
Documentation=https://github.com/nightgopher/litellm-gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=easygateway
Group=easygateway
WorkingDirectory=/etc/easygateway
EnvironmentFile=/etc/easygateway/easygateway.env
ExecStart=/usr/bin/gateway
Restart=on-failure
RestartSec=3s

# 加固：文件系统只读，仅运行数据目录可写
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/easygateway
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
