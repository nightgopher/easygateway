#!/bin/bash
# Codex 模型切换脚本
# 配合 easygateway 使用，切换 Codex CLI 的模型配置
#
# 用法：
#   codex-model gateway <模型>  → 走网关（默认模型 glm-opus）
#   codex-model native          → 走 OpenAI 原生认证
#   codex-model status          → 查看当前配置
#
# 安装：
#   cp scripts/codex-model ~/.local/bin/codex-model
#   chmod +x ~/.local/bin/codex-model
#
# 网关默认模型：coding, glm-opus, glm-sonnet, glm-haiku, glm-vision, ali-opus
# 可选 Provider 的模型以网关 GET /v1/models 返回结果为准。

set -e

CODEX_CONFIG="$HOME/.codex/config.toml"
CODEX_CONFIG_BAK="$HOME/.codex/config.toml.codex-model.bak"
GATEWAY_KEY="${EASYGATEWAY_MASTER_KEY:-}"
GATEWAY_URL="${GATEWAY_URL:-http://localhost:4001/v1}"

if [ -z "$GATEWAY_KEY" ]; then
  ENV_FILE="$HOME/Desktop/develop/test/easygateway/go-gateway/.env"
  if [ -f "$ENV_FILE" ]; then
    GATEWAY_KEY=$(grep -E '^(EASYGATEWAY|LITELLM)_MASTER_KEY=' "$ENV_FILE" | cut -d'=' -f2-)
  fi
fi

if [ -z "$GATEWAY_KEY" ]; then
  echo "⚠️  未设置 GATEWAY_KEY，请设置 EASYGATEWAY_MASTER_KEY 环境变量或在 .env 中配置"
  exit 1
fi

backup_config() {
  cp "$CODEX_CONFIG" "$CODEX_CONFIG_BAK"
  echo "📦 已备份原配置到 $CODEX_CONFIG_BAK"
}

# ---------- 精确修改 TOML ----------
# 策略：用 awk 过滤掉要删除的行，然后直接在第一个 [section] 之前插入新配置

set_gateway_mode() {
  local model="$1"
  local tmpfile="/tmp/codex-model-$$.toml"

  awk '
    # 删除旧的 gateway 相关行
    /^model_provider = / { next }
    /^disable_response_storage = / { next }
    /^model_catalog_json = / { next }
    /^\[model_providers\.gateway\]/ { in_gateway=1; next }
    in_gateway && /^\[/ { in_gateway=0 }
    in_gateway { next }

    # 在第一个 [section] 之前插入新配置
    /^\[/ && !inserted {
      inserted = 1
      print "model_provider = \"gateway\""
      print "model_catalog_json = \"gateway-model-catalog.json\""
      print "disable_response_storage = true"
      print ""
      print "[model_providers.gateway]"
      print "name = \"my-gateway\""
      print "base_url = \"'$GATEWAY_URL'\""
      print "wire_api = \"responses\""
      print "requires_openai_auth = true"
      print "experimental_bearer_token = \"'$GATEWAY_KEY'\""
      print ""
      print $0
      next
    }

    { print }
  ' "$CODEX_CONFIG" > "$tmpfile"

  # 替换 model 和 model_reasoning_effort 行
  sed -i '' "s/^model = \".*\"/model = \"$model\"/" "$tmpfile"
  sed -i '' "s/^model_reasoning_effort = \".*\"/model_reasoning_effort = \"high\"/" "$tmpfile"

  cp "$tmpfile" "$CODEX_CONFIG"
  rm -f "$tmpfile"
  echo "✅ 网关模式 → $model ($GATEWAY_URL)"
}

set_native_mode() {
  local model="$1"
  local tmpfile="/tmp/codex-model-$$.toml"

  awk '
    # 删除 gateway 相关行（native 模式不需要）
    /^model_provider = / { next }
    /^disable_response_storage = / { next }
    /^model_catalog_json = / { next }
    /^\[model_providers\.gateway\]/ { in_gateway=1; next }
    in_gateway && /^\[/ { in_gateway=0 }
    in_gateway { next }

    # 在第一个 [section] 之前插入 model_provider
    /^\[/ && !inserted {
      inserted = 1
      print "model_provider = \"openai\""
      print ""
      print $0
      next
    }

    { print }
  ' "$CODEX_CONFIG" > "$tmpfile"

  # 替换 model 和 model_reasoning_effort 行
  sed -i '' "s/^model = \".*\"/model = \"$model\"/" "$tmpfile"
  sed -i '' "s/^model_reasoning_effort = \".*\"/model_reasoning_effort = \"high\"/" "$tmpfile"

  cp "$tmpfile" "$CODEX_CONFIG"
  rm -f "$tmpfile"
  echo "✅ 原生模式 → $model (OpenAI 官方认证)"
}

# ---------- 主流程 ----------

MODE="$1"
MODEL="$2"

case "$MODE" in
  gateway|gw)
    MODEL="${MODEL:-glm-opus}"
    backup_config
    set_gateway_mode "$MODEL"
    ;;
  native)
    MODEL="${MODEL:-gpt-5.5}"
    backup_config
    set_native_mode "$MODEL"
    ;;
  status)
    echo "📋 当前 Codex 模型配置:"
    grep -E "^model_provider|^model = " "$CODEX_CONFIG" | head -3
    echo ""
    echo "📂 完整配置: $CODEX_CONFIG"
    ;;
  restore)
    if [ -f "$CODEX_CONFIG_BAK" ]; then
      cp "$CODEX_CONFIG_BAK" "$CODEX_CONFIG"
      echo "♻️  已从备份恢复配置"
    else
      echo "⚠️  没有找到备份文件"
    fi
    ;;
  *)
    echo "用法: codex-model <模式> [模型]"
    echo ""
    echo "  gateway [模型]  → 走网关（默认 glm-opus）"
    echo "  native [模型]   → 走 OpenAI 原生认证（默认 gpt-5.5）"
    echo "  status          → 查看当前配置"
    echo "  restore         → 恢复上一次备份"
    echo ""
    echo "网关可用模型:"
    echo "  coding, glm-opus, glm-sonnet, glm-haiku, glm-vision, ali-opus"
    echo "  其他模型请读取网关 GET /v1/models"
    ;;
esac
